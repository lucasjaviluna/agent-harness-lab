{
  "name": "agent-harness-lab",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "Laboratorio incremental: governance, aprobaciones y evidencia",
  "bin": {
    "agent-lab": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js",
    "sdk:run": "node --experimental-strip-types examples/sdk/run.ts",
    "sdk:typecheck": "tsc -p examples/sdk/tsconfig.json",
    "sdk:tool": "node --experimental-strip-types examples/sdk/custom-tool.example.ts",
    "rpc:run": "npm run build --silent && node dist/rpc-cli.js",
    "memory:search": "node examples/memory/search.mjs",
    "workflow:run": "npm run build --silent && node dist/workflow-cli.js",
    "evidence:verify": "npm run build --silent && node dist/evidence-cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
